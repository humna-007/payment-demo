{
  "version": 2,
  "builds": [
    { "src": "create-checkout-session.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/create-checkout-session", "dest": "/create-checkout-session.js" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
